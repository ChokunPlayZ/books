{
  "name": "meemai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "test:e2e": "node tests/browser/run.mjs",
    "test:multi-user": "node tests/browser/multi-user.browser.mjs",
    "test:preferences": "node tests/browser/preferences.browser.mjs",
    "test:admin": "node tests/browser/admin.browser.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "import": "node scripts/import.mjs",
    "backup": "node scripts/backup.mjs",
    "db:migrate:sqlite": "node scripts/migrate-sqlite.mjs",
    "user:add": "node scripts/user.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "@next/env": "16.4.5",
    "blurhash": "^2.0.5",
    "next": "16.4.5",
    "openid-client": "6.8.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.64.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
