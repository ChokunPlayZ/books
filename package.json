    "test:e2e": "node tests/app/browser.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "import": "node scripts/import.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "prettier": "^3.9.9"
  }
