  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Add/Save; extracted from layout.css, chrome.css and final interface.css.",
      "html": "<button class=\"ds-primary\">Add book</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--line);border-radius:var(--ui-radius);font:600 14px/1.5 var(--ui-font);text-decoration:none;cursor:pointer;box-shadow:none;transition:background 160ms ease,border-color 160ms ease,box-shadow 160ms ease,color 160ms ease;background:var(--primary);color:var(--on-primary);border-color:var(--primary);}.ds-primary:hover{background:var(--primary-hover);}.ds-primary:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-primary:active:not(:disabled){transform:translateY(1px);}.ds-primary:disabled{opacity:.5;cursor:not-allowed;transform:none;}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Check and other secondary actions; same 44px minimum as Add.",
      "html": "<button class=\"ds-secondary\">Check a book</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--line);border-radius:var(--ui-radius);font:600 14px/1.5 var(--ui-font);text-decoration:none;cursor:pointer;box-shadow:none;transition:background 160ms ease,border-color 160ms ease,box-shadow 160ms ease,color 160ms ease;background:var(--white);color:var(--ink);}.ds-secondary:hover{background:var(--button-hover);}.ds-secondary:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-secondary:active:not(:disabled){transform:translateY(1px);}.ds-secondary:disabled{opacity:.5;cursor:not-allowed;transform:none;}"
    },
    {
      "name": "Destructive action",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "The existing danger variant uses red text and semantic border/hover tokens.",
      "html": "<button class=\"ds-danger\">Remove book</button>",
      "css": ".ds-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--line);border-radius:var(--ui-radius);font:600 14px/1.5 var(--ui-font);text-decoration:none;cursor:pointer;box-shadow:none;transition:background 160ms ease,border-color 160ms ease,box-shadow 160ms ease,color 160ms ease;background:var(--white);color:var(--red);border-color:var(--danger-line);}.ds-danger:hover{background:var(--danger-hover);}.ds-danger:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-danger:active:not(:disabled){transform:translateY(1px);}.ds-danger:disabled{opacity:.5;cursor:not-allowed;transform:none;}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Header backup and low-emphasis utility actions; chrome.css text-btn states.",
      "html": "<button class=\"ds-text\">Data &amp; backups</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px;border:0;border-radius:8px;background:none;color:var(--muted);font:400 13px/1.5 var(--ui-font);text-decoration:none;cursor:pointer;transition:background 160ms ease,color 160ms ease;}.ds-text:hover{background:var(--soft);color:var(--green);}.ds-text:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-text:disabled{opacity:.5;cursor:not-allowed;}"
    },
    {
      "name": "Entry field",
      "kind": "input",
      "refersTo": "field",
      "description": "Shared 16px entry field, 48px minimum; layout.css and interface.css.",
      "html": "<label class=\"ds-field\"><span>Series name *</span><input placeholder=\"Choose a title or enter a new one\" required></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:var(--ink);font:600 13px/1.5 var(--ui-font);}.ds-field input{min-width:0;min-height:48px;padding:11px 13px;border:1px solid var(--line);border-radius:var(--ui-radius);background:var(--white);color:var(--ink);font:400 16px/1.5 var(--ui-font);caret-color:var(--primary);}.ds-field input::placeholder{color:var(--placeholder);opacity:1;}.ds-field input:hover{border-color:var(--line-hover);}.ds-field input:focus{border-color:var(--green);}.ds-field input:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Current destination",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "CollectionTabs desktop rail with the handheld strip rules from interface.css.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Collection views\"><a class=\"ds-destination\" href=\"#collection\" aria-current=\"page\">Collection</a><a class=\"ds-destination\" href=\"#discover\">Discover titles</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:4px;width:198px;}.ds-destination{display:flex;align-items:center;gap:12px;min-height:44px;padding:11px 14px;border:0;border-radius:7px;background:transparent;color:var(--muted);font:500 13px/1.5 var(--ui-font);white-space:nowrap;text-decoration:none;transition:background 160ms ease,color 160ms ease;}.ds-destination:hover{background:var(--button-hover);color:var(--green);}.ds-destination[aria-current]{background:var(--tab-active);color:var(--green);font-weight:650;}.ds-destination:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}@media(max-width:760px){.ds-nav{flex-direction:row;width:100%;overflow-x:auto;}.ds-destination{flex:0 0 auto;gap:7px;padding:10px 12px;}}"
    },
    {
      "name": "Reading status",
      "kind": "chip",
      "refersTo": "status-read",
      "description": "Neutral, Read and Reading badges from layout.css and collection.css; informational, with no invented interaction.",
      "html": "<div class=\"ds-statuses\"><span class=\"ds-status\">Sealed</span><span class=\"ds-status ds-read\">Read</span><span class=\"ds-status ds-reading\">Reading</span></div>",
      "css": ".ds-statuses{display:flex;flex-wrap:wrap;gap:8px;}.ds-status{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:20px;background:var(--status-background);color:var(--ink);white-space:nowrap;font:400 11px/1.5 var(--ui-font);}.ds-status::before{content:\"\";width:5px;height:5px;border-radius:50%;background:#a5af9d;}.ds-read{background:var(--success-background);color:var(--success-ink);}.ds-read::before{background:#6e9561;}.ds-reading{background:var(--warning-background);color:var(--warning-ink);}.ds-reading::before{background:#cba254;}"
    },
    {
      "name": "Shelf entry without a cover",
      "kind": "card",
      "refersTo": "shelf-cover",
      "description": "ShelfEntries fallback, showing the existing title and metadata treatment at the shipped cover ratio; interface.css and shelf.css.",
      "html": "<a class=\"ds-book\" href=\"#series\"><span class=\"ds-cover\"><span class=\"ds-cover-title\">Series title</span><span class=\"ds-no-cover\">No cover</span></span><span class=\"ds-caption\">Series title</span><span class=\"ds-detail\">3 volumes</span></a>",
      "css": ".ds-book{display:block;width:150px;padding:0;border:0;background:transparent;color:var(--ink);text-decoration:none;font-family:var(--ui-font);}.ds-cover{display:flex;flex-direction:column;align-items:flex-start;gap:14px;aspect-ratio:264/370;padding:18px 14px;border:1px solid var(--line);border-radius:3px;background:var(--surface-inset);box-shadow:1px 3px 8px #14203814;}.ds-cover-title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:5;overflow:hidden;font:600 16px/1.45 var(--ui-font);}.ds-no-cover{margin-top:auto;color:var(--muted);font:400 10px/1.5 var(--ui-font);}.ds-caption{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;margin:10px 0 3px;font:600 13px/1.45 var(--ui-font);}.ds-detail{display:block;color:var(--muted);font:400 12px/1.5 var(--ui-font);}.ds-book:hover .ds-caption{color:var(--green);}.ds-book:focus-visible{outline:3px solid var(--focus);outline-offset:5px;}@media(max-width:760px){.ds-cover{padding:16px;}.ds-cover-title{font-size:15px;}.ds-caption{font-size:14px;}}"
    },
    {
      "name": "Entry footer",
      "kind": "custom",
      "refersTo": "entry-dialog-handheld",
      "description": "BookDialog handheld footer: an optional repeat-entry control, secondary Cancel and 50px Save action.",
      "html": "<section class=\"ds-entry-foot\"><label class=\"ds-repeat\"><input type=\"checkbox\"> Add another book after saving</label><div class=\"ds-save-actions\"><button class=\"ds-cancel\">Cancel</button><button class=\"ds-save\">Add book</button></div></section>",
      "css": ".ds-entry-foot{padding:10px 16px max(12px,env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--white);color:var(--ink);font:400 14px/1.5 var(--ui-font);}.ds-repeat{display:flex;align-items:center;gap:8px;min-height:44px;color:var(--muted);}.ds-repeat input{width:22px;height:22px;}.ds-repeat input:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-save-actions{display:flex;gap:8px;}.ds-cancel,.ds-save{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--line);border-radius:var(--ui-radius);font:600 14px/1.5 var(--ui-font);text-decoration:none;cursor:pointer;box-shadow:none;transition:background 160ms ease,border-color 160ms ease,box-shadow 160ms ease,color 160ms ease;min-height:50px;font-size:15px;}.ds-cancel{background:var(--white);color:var(--ink);}.ds-save{flex:1;background:var(--primary);color:var(--on-primary);border-color:var(--primary);}.ds-cancel:hover{background:var(--button-hover);}.ds-save:hover{background:var(--primary-hover);}.ds-cancel:focus-visible,.ds-save:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-cancel:active:not(:disabled),.ds-save:active:not(:disabled){transform:translateY(1px);}.ds-cancel:disabled,.ds-save:disabled{opacity:.5;transform:none;cursor:not-allowed;}"
    }
  ],
  "narrative": {
    "northStar": "The Handheld Collection Utility",
    "overview": "The handheld collection utility is quiet, precise and book-led. Cool neutral surfaces, graphite text and restrained cobalt actions support capture and browsing; actual covers supply the visual variety.\n\nThe interface uses native UI typography, compact corners and divided summaries. Handheld controls stay within reach; desktop space expands the shelf rather than enlarging decorative chrome.",
    "keyCharacteristics": [
      "Cool neutral surfaces and cobalt actions.",
      "Compact UI typography with readable catalog metadata.",
      "Flat summaries, real cover imagery and restrained component borders.",
      "Handheld capture controls and a desktop navigation rail."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Use cobalt for actions, links, focus and the current destination; let book covers carry the broader color range.",
        "section": "colors"
      },
      {
        "name": "The Utility Type Rule",
        "body": "Use the shared UI stack for headings, metadata and entry controls. Keep page titles compact and labels in sentence case.",
        "section": "typography"
      },
      {
        "name": "The Flat Summary Rule",
        "body": "Collection counts sit inline above a divider. Reserve elevation for overlays and the physical edge of a cover.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared UI font and theme variables for reusable surfaces.",
      "Do preserve the 44px primary control minimum and the 48–50px handheld entry controls.",
      "Do keep capture actions and entry Save reachable above the safe area and virtual keyboard.",
      "Do preserve visible keyboard focus, current navigation visibility and readable selected filter text.",
      "Do use real collection covers; show a plain title placeholder when a cover is unavailable."
    ],
    "donts": [
