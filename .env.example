# SQLite must live on a persistent volume in production.
BOOKS_DATABASE_PATH=./data/books.sqlite
BOOKS_TIME_ZONE=Asia/Bangkok
# Exact public origin. HTTPS is required except on localhost/loopback.
BOOKS_APP_URL=http://localhost:3000
# Google Cloud OAuth client type: Web application. Keep the secret server-side.
# Authorized redirect URI: BOOKS_APP_URL + /api/auth/google/callback
BOOKS_GOOGLE_CLIENT_ID=
BOOKS_GOOGLE_CLIENT_SECRET=
# Gmail or Google Workspace email that claims the existing admin library ONCE.
# Never assigned to the first public signup. Changing this does not reassign a linked library.
BOOKS_ADMIN_EMAIL=
# Docker Compose publishes on loopback by default; change the host port if needed.
BOOKS_BIND_ADDRESS=127.0.0.1
BOOKS_PORT=3000
