# SQLite must live on a persistent volume in production.
BOOKS_DATABASE_PATH=./data/books.sqlite
BOOKS_TIME_ZONE=Asia/Bangkok
# Required in production. Set a long private password before hosting.
BOOKS_PASSWORD=
# Enable only for a private local deployment without a password.
BOOKS_ALLOW_UNAUTHENTICATED=false
# Local HTTP: false. Set true when hosting behind an HTTPS reverse proxy.
BOOKS_SECURE_COOKIES=false
# Docker Compose publishes on loopback by default; change the host port if needed.
BOOKS_BIND_ADDRESS=127.0.0.1
BOOKS_PORT=3000
